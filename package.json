{
  "name": "jcbc-demo",
  "version": "0.1.0",
  "private": true,
  "description": "AI駆動開発デモ用のお問い合わせ管理アプリ",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "gts lint",
    "format": "gts fix",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "gts": "7.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "type": "module",
  "overrides": {
    "tmp": "^0.2.6"
  }
}
